
script="$(realpath $0)"

tellfail(){
	exit_no="$?"
    if [ "$exit_no" -eq 0 ]; then
        sed -i "2cfailures=0" $script
    else
        eval "$(sed -n '2p' $script)"
        failures=$(( failures + 1 ))
        sed -i "2cfailures=$failures" $script
        [ "$failures" -lt 3 || echo "$0 failed" | tellme.sh
		exit "$exit_no"
    fi
}

trap tellfail EXIT

