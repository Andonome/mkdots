root=/home/ghost
root=ssh://ghost@splint.rs:2360//home/ghost/
times=true

log = false
ignore=Name temp.*
ignore=Name *pid
ignore=Name *.tmp
ignore=Name node_modules
ignore=Name rubbish
ignore=Name svg-inkscape
ignore=Name public
ignore=Name Library

path=rec
path=pro
path=kn

path=.timewarrior
path=.w3m/bookmark.html

path=.local/share/calcurse
path=.local/share/newsraft

path=.local/share/contacts
path=.config/.bombadillo.ini
path=.config/lagrange

path=.config/qutebrowser/bookmarks
path=.config/qutebrowser/quickmarks

path=.vim/spell/en.utf-8.add
