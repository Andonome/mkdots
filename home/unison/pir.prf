root=/home/ghost
root=ssh://ghost@splint.rs:2360//home/ghost/
times=true
copyonconflict=true
prefer=newer

log = false
ignore=Name temp.*
ignore=Name *pid
ignore=Name *.tmp
ignore=Name node_modules
ignore=Name rubbish
ignore=Name public

path=rec
path=.map
path=.timewarrior
path=pro
path=.w3m/bookmark.html

path=.local/share/calcurse
path=.local/share/newsraft

path=.local/share/contacts
path=.local/state/task
path=.config/lf
path=.config/zathura
path=.config/.bombadillo.ini
path=.config/lagrange
path=.config/himalaya
path=.config/weechat
path=.tmux.conf

path=.config/qutebrowser
ignore=Name .config/qutebrowser/webengine

path=kn

path=.config/aerc
path=.config/profanity/profrc
path=.config/profanity/accounts
path=.vim/spell/en.utf-8.add
