function slow(){
	ff=/tmp/bashpipe_$(date +%s)
	mkfifo $ff 2>/dev/null
	( cat $ff | perl -We 'use Time::HiRes;$|++;while(read(STDIN,$c,1)){Time::HiRes::usleep(15000);print $c;}' )& exec &> $ff
}

