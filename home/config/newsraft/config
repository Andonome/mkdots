set scrolloff 5
set download-timeout 6
set scrolloff 4
set reload-period 1440
bind ^P mark-unread-all
bind m mark-read; exec mpv --no-terminal "%l" &
bind ^o mark-read; exec mpv "%l"
bind V mark-read; exec echo "%l" >> ~/vids/.list
bind o mark-read; exec xdg-open "%l"
bind w mark-read; exec w3m "%l"
bind E exec $EDITOR ~/.config/newsraft/feeds
bind C exec $EDITOR ~/.config/newsraft/config
bind M exec man newsraft
